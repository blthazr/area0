{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    "github>blthazr/area0//.renovate/autoMerge.json5",
    "github>blthazr/area0//.renovate/changeLogs.json5",
    "github>blthazr/area0//.renovate/groups.json5",
    "github>blthazr/area0//.renovate/labels.json5",
    "github>blthazr/area0//.renovate/schedule.json5",
    ":timezone(America/Chicago)",
  ],
  lockFileMaintenance: {
    additionalBranchPrefix: "{{manager}}-",
    commitMessageExtra: "({{manager}})",
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
  },
}
